# .env.template
# ============================================
# DOCKER COMPOSE ENVIRONMENT TEMPLATE
# Copy this file to .env and adjust values
# ============================================

# Application settings
NODE_ENV=production
JWT_SECRET=your-secret-key-please-change

# Security & Network
TRUST_PROXY_ENABLED=false
TRUSTED_PROXY_IPS=nginx-proxy,172.0.0.0/8,10.0.0.0/8,192.168.0.0/16

# Optional features
ENABLE_PRO=false

# Port configuration
APP_PORT=3002
FORCE_HTTPS=false
# APP_URL=http://localhost:3002 - is being set by docker compose based on the port mapping

# Rate Limits
RATE_LIMIT_MAX_REQUESTS=500
AUTH_RATE_LIMIT_MAX_REQUESTS=100
EXPENSIVE_ENDPOINT_LIMIT=100

RATE_LIMIT_WINDOW_MS=300000

# ============================================
# END OF TEMPLATE
# ============================================